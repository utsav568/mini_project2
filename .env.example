# ==============================================================================
# GuardianNodes RoadSoS - Environment Configuration Template
# Platform: Next-Gen Intelligent Road Accident Emergency Response (Delhi NCR Node)
# ==============================================================================

# Server Network & Host Binding
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Security & Session Authentication
ROADSOS_SECRET_KEY=change-in-production-roadsos-emergency-key-998822
ROADSOS_SESSION_TIMEOUT_MINUTES=120
ROADSOS_PASSWORD_SALT=roadsos_delhi_ncr_v2_salt

# Database Persistence Settings
# Uses SQLite in WAL (Write-Ahead Logging) mode with 10s busy timeout
ROADSOS_DB_PATH=roadsafety/data/roadsafety.db
ROADSOS_DB_TIMEOUT=10.0
ROADSOS_DB_WAL_MODE=true

# Operational Simulation Parameters
# Average vehicle cruising speeds across Delhi NCR road network (km/h)
SIM_AMBULANCE_SPEED_KMH=45.0
SIM_FIRE_TENDER_SPEED_KMH=38.0
SIM_POLICE_SPEED_KMH=50.0
SIM_DISPATCH_TIMEOUT_SECONDS=60.0
SIM_DEFAULT_GOLDEN_HOUR_MINUTES=60.0

# V2X BLE / RF Mesh Protocol Settings
V2X_MESH_CRC_POLYNOMIAL=0x04C11DB7
V2X_PACKET_LOSS_RATE_DEFAULT=0.05
V2X_RELAY_LATENCY_BASE_MS=12.5
V2X_RETRANSMISSION_MAX_HOPS=8

# Logging & Storage Paths
ROADSOS_LOG_LEVEL=INFO
ROADSOS_EVIDENCE_DIR=roadsafety/data/evidence/
ROADSOS_REPORTS_DIR=roadsafety/
